# Template file for 'librewolf-bin'
pkgname=librewolf-bin
version=156.0.1
revision=1
_distver="${version%.*}-${version##*.}"
archs="x86_64 aarch64"
short_desc="Community-maintained fork of Firefox focused on privacy and security"
maintainer="zenobit <zen@osowoso.org>"
license="MPL-2.0"
homepage="https://librewolf.net"
distfiles="https://dl.librewolf.net/librewolf/${_distver}/librewolf-${_distver}-linux-x86_64-package.tar.xz
 https://dl.librewolf.net/librewolf/${_distver}/librewolf-${_distver}-linux-arm64-package.tar.xz"
checksum="bdf26e9c7c694aadcc6fb0ffbd71b9b00192b0b42ad1797194cd74caaa6f8206
 028de2a434e30a2d4723b03748093e7fb9053b2be2244463a7608b419dfc1999"
conflicts="librewolf"
#shlib_provides="libonnxruntime.so.1"
nostrip=yes

do_extract() {
	local archiv
	case "$XBPS_TARGET_MACHINE" in
		x86_64) archiv="librewolf-${_distver}-linux-x86_64-package.tar.xz" ;;
		aarch64) archiv="librewolf-${_distver}-linux-arm64-package.tar.xz" ;;
	esac
	vextract "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${archiv}"
}

do_install() {
vmkdir usr/lib/librewolf
vcopy "*" usr/lib/librewolf
vmkdir usr/share/applications
vcopy "${FILESDIR}/librewolf.desktop" usr/share/applications
vinstall browser/chrome/icons/default/default128.png 644 usr/share/pixmaps librewolf.png
vbin "${FILESDIR}/librewolf"
}
