# Template file for 'morgenwm'
pkgname=morgenwm
version=0.2.1
revision=1
hostmakedepends="nim pkg-config"
makedepends="libxkbcommon-devel wayland-devel"
depends="river-compositor libxkbcommon"
short_desc="Scrolling window manager with subframes for the River compositor"
maintainer="LinuxNation <linuxnation@posteo.com>"
license="GPL-3.0-only"
homepage="https://codeberg.org/LinuxNation/MorgenWM"
changelog="https://codeberg.org/LinuxNation/MorgenWM/raw/branch/master/CHANGELOG.md"
distfiles="https://codeberg.org/LinuxNation/MorgenWM/archive/v${version}.tar.gz"
checksum=c95147c1979d6610dc14d30572087c9a79887901a35268565e801b69757b857b
conf_files="/etc/morgenwm/config.toml"

do_build() {
	for _bin in morgenwm launch_morgenwm morgenwm_msg morgenwm_keys; do
		nim c --noNimblePath -d:release -o:bin/$_bin src/${_bin}.nim
	done
}

do_install() {
	for _bin in morgenwm launch_morgenwm morgenwm_msg morgenwm_keys; do
		vbin bin/$_bin
	done
	vinstall example/morgenwm.desktop 644 usr/share/wayland-sessions
	vinstall example/config-minimal.toml 644 etc/morgenwm config.toml
	vmkdir usr/share/morgenwm
	vcopy example/templates usr/share/morgenwm/templates
	vmkdir usr/share/doc/morgenwm
	vcopy docs usr/share/doc/morgenwm
}
